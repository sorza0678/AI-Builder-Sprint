# backend/.env 로 복사해서 사용 (절대 커밋 금지)

# --- B: Supabase(PostgreSQL) 전환 시 ---
# 비워두면 SQLite(backend/resale_guard.db) 사용 — 로컬 개발/테스트 기본값
# 채우면 Postgres 사용. direct connection(5432)보다 PgBouncer 풀러(6543, ?pgbouncer=true) 권장
# (Supabase 프로젝트 설정 > Database > Connection pooling 에서 확인)
DATABASE_URL=postgresql://user:password@host:6543/dbname?pgbouncer=true

# --- A: Upstage Solar (선택) — console.upstage.ai 에서 발급. 없으면 Rule Engine만으로 동작 ---
UPSTAGE_API_KEY=
# 기본 solar-pro3. 바꿀 때만 주석 해제
# UPSTAGE_MODEL=solar-pro3
